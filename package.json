  "description": "Agent Skills untuk developer Indonesia: payment gateway lokal (Midtrans, Xendit, Doku), hosting VPS Indonesia & cPanel, data & formulir Indonesia, notifikasi WhatsApp/Telegram/Email, serta data resmi & aturan berperiode (BMKG, BPS, BI, Bapanas, pajak, BPJS, UMP).",
  "type": "module",
  "bin": {
    "indonesian-dev-skills": "bin/indonesian-dev-skills.mjs"
  },
  "files": [
    "bin",
    "skills",
    ".claude-plugin",
    "scripts",
    "AGENTS.md",
    "QUICKSTART.md",
    "CHANGELOG.md",
    "README.md",
    "README.en.md",
